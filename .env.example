# 웹: apps/web/.env.local에 복사. 운영에서 MOCK_MODE=false.
MOCK_MODE=true
AUTH_PASSWORD=replace-with-a-long-private-password
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
SIGNED_URL_TTL_SECONDS=14400
CATALOG_CACHE_TTL_SECONDS=30
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# NAS: services/collector/.env로 복사하고 chmod 600 적용. 별도 쓰기 키 사용.
CHANNEL_URL=https://www.youtube.com/@새가나안교회/streams
TZ=Asia/Seoul
WINDOW_START=00:00
WINDOW_END=06:30
MAX_CANDIDATES=20
AUDIO_BITRATE=192K
DATA_DIR=/data
STATE_DIR=/state
LOG_DIR=/logs
RETENTION_DAYS=90
RETENTION_ENABLED=false
