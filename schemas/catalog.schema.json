{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "sourceUrl",
          "broadcastStartedAt",
          "serviceDate",
          "durationSeconds",
          "sizeBytes",
          "bitrateKbps",
          "objectKey",
          "publishedAt",
          "audioScope",
          "availability"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "sourceUrl": {
            "type": "string",
            "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]+$"
          },
          "broadcastStartedAt": { "type": "string", "format": "date-time" },
          "serviceKind": { "enum": ["dawn", "evening", "sunday"] },
          "serviceDate": { "type": "string", "format": "date" },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "bitrateKbps": { "type": "integer", "minimum": 8, "maximum": 320 },
          "objectKey": {
            "type": "string",
            "pattern": "^audio/[0-9]{4}/[0-9]{2}/[A-Za-z0-9_-]+\\.mp3$"
          },
          "publishedAt": { "type": "string", "format": "date-time" },
          "audioScope": { "const": "full_service" },
          "availability": { "enum": ["available", "unavailable"] }
        }
      }
    }
  }
}
